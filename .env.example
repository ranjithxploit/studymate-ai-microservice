# AI Explainer Bot - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================
# Google Gemini API Configuration
# ===========================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (default: gemini-2.0-flash-exp)
# Options: gemini-2.0-flash-exp, gemini-2.5-flash, gemini-pro
GEMINI_MODEL=gemini-2.0-flash-exp

# ===========================
# Instructions
# ===========================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and replace "your_gemini_api_key_here" with your actual API key
# 3. Never commit the .env file to git (it's in .gitignore)
